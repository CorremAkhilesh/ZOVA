{
  "name": "@zuvo/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env --clear-screen=false src/main.ts",
    "dev:worker": "tsx watch --env-file=.env --clear-screen=false src/worker.ts",
    "build": "node scripts/build.ts",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "start:worker": "node --env-file-if-exists=.env --enable-source-maps dist/worker.js",
    "mail:test": "tsx --env-file=.env src/scripts/mail-test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist coverage .turbo",
    "redis:start": "node scripts/redis.ts start",
    "redis:stop": "node scripts/redis.ts stop",
    "redis:status": "node scripts/redis.ts status",
    "db:sync-indexes": "tsx --env-file=.env src/scripts/sync-indexes.ts",
    "admin:role": "tsx --env-file=.env src/scripts/admin-role.ts",
    "bench:realtime": "tsx src/scripts/bench-realtime.ts",
    "test:coverage": "vitest run --coverage",
    "e2e:server": "tsx src/scripts/e2e-server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.7",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.3",
    "@node-rs/argon2": "2.2.2",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.2.0",
    "@scalar/fastify-api-reference": "1.76.4",
    "@simplewebauthn/server": "14.1.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@zuvo/config": "workspace:*",
    "@zuvo/protocol": "workspace:*",
    "@zuvo/ui-tokens": "workspace:*",
    "better-auth": "1.7.16",
    "bowser": "2.15.0",
    "bullmq": "6.5.3",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "22.3.0",
    "ioredis": "6.0.0",
    "mongodb": "7.7.0",
    "mongoose": "9.11.4",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  }
}
