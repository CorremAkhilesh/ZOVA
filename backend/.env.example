# Runtime environment: development | test | production
NODE_ENV=development
# Port the API server listens on
PORT=4000
# Interface to listen on (optional). Default: 127.0.0.1 in development, 0.0.0.0 otherwise
HOST=
# Public URL of the frontend (used for CORS, cookies, links in emails)
APP_URL=http://127.0.0.1:5191
# Public URL of this API
API_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API (CORS). Dev frontend: port 5191.
CORS_ORIGINS=http://127.0.0.1:5191,http://localhost:5191

# MongoDB Atlas connection string (no database name in the path — see MONGODB_DB)
# mongodb+srv://<user>:<password>@cluster0.zitp2pj.mongodb.net/?retryWrites=true&w=majority&appName=zuvo
MONGODB_URI=
# Database name: zuvo_dev (local + staging) | zuvo_prod (production)
MONGODB_DB=zuvo_dev

# Redis URL. Local: Zuvo's own Memurai process on 127.0.0.1:6391 (pnpm redis:start; never the shared 6379).
# Staging/production: the Redis container on the VPS. Use rediss:// for TLS.
# Optional in development (rate limiting falls back to in-memory); required in production.
# Format: redis://:<password>@127.0.0.1:6391
REDIS_URL=

# Redis integration tests only (database 15 of the local Memurai). Leave empty to skip them.
# Format: redis://:<password>@127.0.0.1:6391/15
REDIS_TEST_URL=

# Outgoing mail (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
# 465 = implicit TLS (SSL)
SMTP_PORT=465
# true for port 465
SMTP_SECURE=true
# Mailbox login
SMTP_USER=nova@corremadvisory.com
# Mailbox password — wrap in single quotes if it contains special characters
SMTP_PASS=
# Sender address only — MUST equal SMTP_USER (Hostinger requirement); display name comes from brand.ts
MAIL_FROM=nova@corremadvisory.com

# Comma-separated email domains allowed to sign up / log in (exact match)
ALLOWED_EMAIL_DOMAINS=corremadvisory.com

# Media storage folder (relative paths resolve from backend/). VPS: /srv/zuvo/<staging|prod>/media
MEDIA_STORAGE_PATH=./storage/uploads

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
