# Runtime environment: development | test | production
NODE_ENV=development
# Port the API server listens on. Shared machine: pick your own (e.g. 4007) and set the same number
# as ZUVO_API_PORT in frontend/.env.local, so the Vite proxy finds it.
PORT=4000
# Interface to listen on (optional). Default: 127.0.0.1 in development, 0.0.0.0 otherwise
HOST=
# Public URL of the frontend (used for CORS, cookies, links in emails)
APP_URL=http://127.0.0.1:5191
# Public URL of this API
API_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API (CORS). Dev frontend: ZUVO_DEV_PORT (5191).
CORS_ORIGINS=http://127.0.0.1:5191,http://localhost:5191

# MongoDB Atlas connection string (no database name in the path — see MONGODB_DB)
# mongodb+srv://<user>:<password>@cluster0.zitp2pj.mongodb.net/?retryWrites=true&w=majority&appName=zuvo
MONGODB_URI=
# Database name: zuvo_dev<N> (your own, local) | zuvo_dev (staging) | zuvo_prod (production)
# Your own database on the shared machine: zuvo_dev1, zuvo_dev7, ... (see "Running on the shared
# server" in the README). Never zuvo_dev: staging uses it.
MONGODB_DB=zuvo_dev<N>

# Redis URL. Local: Zuvo's own Memurai process on 127.0.0.1:6391 (pnpm redis:start; never the shared 6379).
# Staging/production: the Redis container on the VPS. Use rediss:// for TLS.
# Optional in development (rate limiting falls back to in-memory); required in production.
# Format: redis://:<password>@127.0.0.1:6391
REDIS_URL=

# Redis integration tests only (database 15 of the local Memurai). Leave empty to skip them.
# Format: redis://:<password>@127.0.0.1:6391/15
REDIS_TEST_URL=

# Outgoing mail (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
# 465 = implicit TLS (SSL)
SMTP_PORT=465
# true for port 465
SMTP_SECURE=true
# Mailbox login
SMTP_USER=nova@corremadvisory.com
# Mailbox password — wrap in single quotes if it contains special characters
SMTP_PASS=
# Sender address only — MUST equal SMTP_USER (Hostinger requirement); display name comes from brand.ts
MAIL_FROM=nova@corremadvisory.com

# Comma-separated email domains allowed to sign up / log in (exact match)
ALLOWED_EMAIL_DOMAINS=corremadvisory.com

# Signs session cookies: 32+ random characters, different per environment.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Comma-separated emails promoted to admin when they sign in (new or existing accounts; never
# demotes; audited as a system action). Required in staging and production.
# The Zuvo admin account: novaadmin@corremadvisory.com
ADMIN_EMAILS=
# OTP requests allowed per client IP per hour
OTP_IP_LIMIT_PER_HOUR=30

# Media storage folder (relative paths resolve from backend/). VPS: /srv/zuvo/<staging|prod>/media
# Uploads in progress wait in .uploads/ inside it. Finished files use random keys in sharded folders.
MEDIA_STORAGE_PATH=./storage/uploads
# The largest file a person can send, in MiB (1024 = 1 GB). The app reads it from GET /v1/config.
# Pictures stay at 100 MB: a larger one goes as a document.
MEDIA_MAX_FILE_MB=1024
# The longest voice note, in seconds (900 = 15 minutes). The app warns 30 seconds before the end.
VOICE_MAX_SECONDS=900

# Web Push (VAPID) key pair, base64url. Generate with: pnpm vapid:gen (prints both lines).
# Required in production (staging too), one pair per environment, never committed. Changing the pair
# makes every device subscribe again. Empty in development: push is off and GET /v1/me/push says so.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services may contact about our pushes (mailto: or https:)
VAPID_SUBJECT=mailto:nova@corremadvisory.com

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
