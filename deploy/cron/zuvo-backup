# /etc/cron.d/zuvo-backup (root:root 0644): daily Zuvo backup at 02:30 server time.
# Installed by docs/runbooks/first-deploy.md step 7. Log: /var/log/zuvo-backup.log
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 2 * * * root /bin/bash /var/www/zuvo/deploy/scripts/backup.sh >> /var/log/zuvo-backup.log 2>&1
