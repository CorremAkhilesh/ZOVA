# deploy/.env.prod: production settings for the whole stack (mongo, redis, backup, migrate, api, worker).
# PLACEHOLDERS ONLY: the real file is created ONCE on the server by `sudo bash deploy/scripts/setup-env.sh`
# (chmod 600, every secret generated there) and is never committed or written by CI.
# NODE_ENV, HOST, PORT and MEDIA_STORAGE_PATH are set in deploy/docker-compose.prod.yml.

# --- App (backend/src/config/env.ts) -------------------------------------------------------------
NODE_ENV=production
APP_URL=https://zuvo.corremadvisory.com
API_URL=https://zuvo.corremadvisory.com
CORS_ORIGINS=https://zuvo.corremadvisory.com
ALLOWED_EMAIL_DOMAINS=corremadvisory.com
ADMIN_EMAILS=novaadmin@corremadvisory.com
# Hidden admins: may a user reply in a chat an admin started? false = announcement only.
ADMIN_CHAT_USER_CAN_REPLY=true
AUTH_SECRET=change-me-64-hex-characters-from-openssl-rand-hex-32-change-me-0000
OTP_IP_LIMIT_PER_HOUR=30
SOCKET_HANDSHAKES_PER_MINUTE=600
MEDIA_MAX_FILE_MB=1024
MEDIA_USER_QUOTA_MB=3072
VOICE_MAX_SECONDS=900
LOG_LEVEL=info

# --- MongoDB (own mongo:8.0 container, single-node replica set rs0, auth + key file) -------------
MONGODB_DB=zuvo_prod
MONGODB_URI=mongodb://zuvo:change-me-app-password@mongo:27017/zuvo_prod?replicaSet=rs0&authSource=zuvo_prod
# Root user: first start, healthcheck and backups only. The app signs in as ZUVO_DB_USER.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-root-password
MONGO_KEYFILE=change-me-1000-base64-characters
ZUVO_DB_USER=zuvo
ZUVO_DB_PASSWORD=change-me-app-password

# --- Redis (own container: password, noeviction, appendonly) -------------------------------------
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379

# --- Email: Hostinger SMTP. MAIL_FROM must equal SMTP_USER; the display name comes from brand.ts --
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=nova@corremadvisory.com
SMTP_PASS=typed-by-the-owner-in-setup-env
MAIL_FROM=nova@corremadvisory.com

# --- Web Push (VAPID P-256 key pair, base64url; generated by setup-env.sh) -----------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nova@corremadvisory.com

# --- Calls (1:1 voice; docs/runbooks/turn-server.md) ----------------------------------------------
# Who may call: admins (plus CALLS_TEST_EMAILS) while calls are tested, or all.
CALLS_ENABLED_FOR=admins
# Extra accounts allowed to call while testing (comma-separated emails).
CALLS_TEST_EMAILS=
# STUN servers (comma-separated stun: URLs). Empty: the built-in default; "none": no STUN.
CALLS_STUN_URLS=
# TURN relay (Part 2): comma-separated turn:/turns: URLs and coturn's static-auth-secret (32+ chars).
# Both empty: STUN only. Credentials are made per person and expire after CALLS_TURN_TTL_SECONDS.
CALLS_TURN_URLS=
CALLS_TURN_SECRET=
CALLS_TURN_TTL_SECONDS=3600
