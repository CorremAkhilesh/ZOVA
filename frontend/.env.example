# Copy to frontend/.env.local (gitignored). Shared machine: pick ports nobody else uses.
# Vite dev server (pnpm dev). Default 5191.
ZUVO_DEV_PORT=5191
# Vite preview server (pnpm preview). Default 5192.
ZUVO_PREVIEW_PORT=5192
# The API port the /v1 and /socket.io proxy forwards to: the same as PORT in backend/.env. Default 4000.
ZUVO_API_PORT=4000
