{
  "name": "zuvo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.34"
  },
  "scripts": {
    "dev": "pnpm redis:start && turbo run dev dev:worker",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf .turbo",
    "redis:start": "pnpm --filter @zuvo/backend redis:start",
    "redis:stop": "pnpm --filter @zuvo/backend redis:stop",
    "redis:status": "pnpm --filter @zuvo/backend redis:status",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "^24.19.2",
    "lefthook": "2.2.2",
    "rimraf": "6.1.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
